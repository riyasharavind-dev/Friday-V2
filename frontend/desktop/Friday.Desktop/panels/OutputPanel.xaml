<Window x:Class="Friday.Desktop.Panels.OutputPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FRIDAY"
        Width="440"
        Height="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFF0F0F5"/>
            <Setter Property="Background" Value="#FF30303D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border Margin="6"
            Background="#ED16161D"
            BorderBrush="#FF454550"
            BorderThickness="1"
            CornerRadius="18">

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <Button DockPanel.Dock="Right"
                        Content="Close"
                        Click="CloseButton_Click"/>

                <TextBlock Text="FRIDAY"
                           Foreground="#FFF0F0F5"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Background="Transparent"
                           MouseLeftButtonDown="Header_MouseLeftButtonDown"/>
            </DockPanel>

            <TextBlock x:Name="OutputTitle"
                       Grid.Row="1"
                       Text="Chat"
                       Foreground="#FFF0F0F5"
                       FontSize="20"
                       Margin="0,18,0,12"
                       TextWrapping="Wrap"/>

            <Border Grid.Row="2"
                    Background="#B80C0C11"
                    CornerRadius="10"
                    Padding="12">

                <TextBox x:Name="OutputContent"
                         Background="Transparent"
                         Foreground="#FFE7E7F0"
                         BorderThickness="0"
                         FontFamily="Segoe UI"
                         FontSize="14"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"/>
            </Border>

            <Grid Grid.Row="3" Margin="0,12,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusLabel"
                           Foreground="#FFAAAAC0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,8,0"/>

                <Button Grid.Column="1"
                        Content="Copy"
                        Click="CopyButton_Click"/>
            </Grid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageInput"
                         Background="#FF22222C"
                         Foreground="#FFF0F0F5"
                         CaretBrush="White"
                         BorderBrush="#FF454550"
                         Padding="10"
                         FontSize="14"
                         MinHeight="42"
                         MaxHeight="100"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="MessageInput_PreviewKeyDown"
                         AutomationProperties.Name="Message FRIDAY"/>

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="Send"
                        Click="SendButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>