<Window x:Class="Friday.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:voice="clr-namespace:Friday.Desktop.Voice"
        Title="FRIDAY"
        Width="250"
        Height="60"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="IslandControl" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="#18FFFFFF"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="#30FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="4"
            Background="#F0141418"
            BorderBrush="#FF34343D"
            BorderThickness="1"
            CornerRadius="26">

        <Grid Margin="12,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="38"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{StaticResource IslandControl}"
                    Padding="5,0"
                    Margin="0,0,8,0"
                    Click="IslandButton_Click"
                    AutomationProperties.Name="Interrupt FRIDAY">

                <voice:WaveformView x:Name="WaveformVisual"
                                    Height="32"/>
            </Button>

            <Border Grid.Column="1"
                    Height="20"
                    Background="#25FFFFFF"
                    VerticalAlignment="Center"/>

            <Button x:Name="PauseButton"
                    Grid.Column="2"
                    Margin="5,0,0,0"
                    Height="32"
                    Style="{StaticResource IslandControl}"
                    Click="PauseButton_Click"
                    ToolTip="Pause FRIDAY"
                    AutomationProperties.Name="Pause FRIDAY">

                <Grid Width="18"
                      Height="18"
                      HorizontalAlignment="Center">

                    <Grid x:Name="PauseIcon">
                        <Rectangle Width="4"
                                   Height="14"
                                   RadiusX="1"
                                   RadiusY="1"
                                   Fill="White"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"/>

                        <Rectangle Width="4"
                                   Height="14"
                                   RadiusX="1"
                                   RadiusY="1"
                                   Fill="White"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Path x:Name="ResumeIcon"
                          Visibility="Collapsed"
                          Fill="White"
                          Data="M 4,2 L 16,9 L 4,16 Z"/>
                </Grid>
            </Button>
        </Grid>
    </Border>
</Window>