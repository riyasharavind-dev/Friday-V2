# FRIDAY environment settings (copy to .env — never commit .env)

# Groq chat (required for conversation)
# Get a free key: https://console.groq.com/keys
FRIDAY_GROQ_API_KEY=
FRIDAY_GROQ_MODEL=openai/gpt-oss-20b

# Reserved for future providers (not used by the V1 desktop path)
FRIDAY_GEMINI_API_KEY=
FRIDAY_OPENROUTER_API_KEY=

# Reserved for future local-model support
FRIDAY_LOCAL_ENABLED=false
FRIDAY_LOCAL_MODEL=

# Optional overrides
# FRIDAY_DATA_DIRECTORY=C:\path\to\friday\data
# FRIDAY_MIC_DEVICE=-1
